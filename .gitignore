# ╔══════════════════════════════════════════════════════════════════╗
# ║  ThriveFusion Alliance Foundation — .gitignore                   ║
# ╚══════════════════════════════════════════════════════════════════╝

# PHP dependencies — INCLUDED in repo so Hostinger can serve them
# The vendor/ dir IS committed to avoid needing Composer on Hostinger
# (Hostinger shared does not guarantee Composer availability)
# vendor/   ← DO NOT IGNORE

# Environment files — NEVER commit secrets
.env
.env.local
.env.production
.env.*
!.env.example

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Node (for local Astro dev only — not deployed)
node_modules/
dist/
.astro/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Astro source (not deployed to Hostinger)
# These should be version controlled but not served directly by the web server

# Temporary build artifacts
*.log
*.tmp
/tmp/

# Firebase Service Accounts
*-firebase-adminsdk-*.json

google-services.json
