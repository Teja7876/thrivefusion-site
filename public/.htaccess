<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle API requests routing to .php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^api/(.*)$ api/$1.php [L,QSA]

  # Route posts detail query: /api/posts/[id] -> /api/posts/detail.php?id=[id]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/posts/([^/]+)$ api/posts/detail.php?id=$1 [L,QSA]

  # Serve HTML pages for static routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
