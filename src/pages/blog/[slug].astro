---
import Layout from "@/layouts/Layout.astro";
import PageContainer from "@/components/layout/PageContainer";
import { format } from "date-fns";
import ReactMarkdown from 'react-markdown';
import { ArrowLeft } from "lucide-react";
import { adminDb } from "@/lib/firebase/server";

export async function getStaticPaths() {
  const posts: any[] = [];
  try {
    const querySnapshot = await adminDb
      .collection("posts")
      .where("published", "==", true)
      .get();
      
    querySnapshot.forEach((doc: any) => {
      posts.push({ id: doc.id, ...doc.data() });
    });
  } catch (e) {
    console.error("Error fetching posts at build time", e);
  }

  return posts.map((post) => {
    return {
      params: { slug: post.slug || post.id },
      props: { post },
    };
  });
}

const { post } = Astro.props;
---

<Layout 
  title={`${post.title} | ThriveFusion Blog`}
  description={post.description}
>
  <Fragment slot="head">
    <meta property="og:title" content={`${post.title} | ThriveFusion Blog`} />
    <meta property="og:description" content={post.description} />
    <meta property="og:type" content="article" />
    {post.imageUrl && <meta property="og:image" content={post.imageUrl} />}
    {post.imageUrl && <meta name="twitter:card" content="summary_large_image" />}
  </Fragment>

  <main class="bg-background pb-24 pt-12">
    <PageContainer narrow>
      <div class="mb-10">
        <a href="/blog" class="inline-flex items-center text-sm font-medium text-muted-foreground hover:text-primary transition-colors">
          <ArrowLeft className="mr-2 h-4 w-4" />
          Back to Blog
        </a>
      </div>
      
      <article class="prose prose-lg dark:prose-invert prose-primary mx-auto max-w-none">
        <header class="mb-12 not-prose">
          <div class="flex items-center gap-x-4 text-sm mb-6">
            <time datetime={post.createdAt} class="text-muted-foreground">
              {format(new Date(post.createdAt), "MMMM d, yyyy")}
            </time>
            {post.categories && post.categories[0] && (
              <span class="rounded-full bg-primary/10 px-3 py-1 font-medium text-primary">
                {post.categories[0]}
              </span>
            )}
          </div>
          <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl mb-6">{post.title}</h1>
          <p class="text-xl text-muted-foreground leading-relaxed mb-8">
            {post.description}
          </p>
          
          <div class="flex items-center gap-x-4 pb-8 border-b border-border">
            <div class="text-sm leading-6">
              <p class="font-semibold text-foreground">By {post.authorName}</p>
            </div>
          </div>
          
          {post.imageUrl && (
            <div class="mt-8 relative w-full h-[300px] sm:h-[400px] lg:h-[500px] rounded-3xl overflow-hidden shadow-lg">
              <img
                src={post.imageUrl}
                alt={post.title}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          )}
        </header>
        
        <div class="mt-12 text-foreground blog-content">
          <ReactMarkdown>{post.content || ''}</ReactMarkdown>
        </div>
      </article>
    </PageContainer>
  </main>
</Layout>
